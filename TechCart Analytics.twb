    <worksheet name='Late Delivery Rate - Scatter Plot'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset' name='federated.0ga9oxl0570y9314lgtkb0831lfu' />
          </datasources>
          <datasource-dependencies datasource='federated.0ga9oxl0570y9314lgtkb0831lfu'>
            <column caption='Review Score' datatype='integer' name='[&quot;review_score&quot;]' role='measure' type='quantitative' />
            <column caption='Avg Seller Rating' datatype='real' name='[Calculation_0824952113106944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [seller_id] : AVG([&quot;review_score&quot;])}' />
            </column>
            <column caption='Orders per Seller' datatype='integer' name='[Calculation_0824952298405893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [seller_id] : COUNTD([order_id])}' />
            </column>
            <column caption='Late Delivery Rate by Seller' datatype='real' name='[Calculation_0824952301187078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [seller_id] : SUM(IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN 1 ELSE 0 END) } / { FIXED [seller_id] : COUNTD([Order_id]) }' />
            </column>
            <column caption='Order id' datatype='string' name='[Order_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0824952113106944]' derivation='None' name='[none:Calculation_0824952113106944:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0824952298405893]' derivation='None' name='[none:Calculation_0824952298405893:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0824952301187078]' derivation='None' name='[none:Calculation_0824952301187078:qk]' pivot='key' type='quantitative' />
            <column-instance column='[seller_id]' derivation='None' name='[none:seller_id:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Seller Id' datatype='string' name='[seller_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:Calculation_0824952113106944:qk]' included-values='non-null' />
          <slices>
            <column>[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:Calculation_0824952113106944:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:Calculation_0824952298405893:qk]' />
              <size column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:Calculation_0824952298405893:qk]' />
              <lod column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:seller_id:nk]' />
            </encodings>
            <trendline enable-confidence-bands='false' enable-instant-analytics='true' enabled='true' exclude-color='false' exclude-intercept='false' fit='linear' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-transparency' value='193' />
                <format attr='has-stroke' value='true' />
                <format attr='stroke-color' value='#333333' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:Calculation_0824952113106944:qk]</rows>
