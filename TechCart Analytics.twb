    <worksheet name='Top Categories by Revenue'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset' name='federated.0ga9oxl0570y9314lgtkb0831lfu' />
          </datasources>
          <datasource-dependencies datasource='federated.0ga9oxl0570y9314lgtkb0831lfu'>
            <column caption='Customer&apos;s First Purchase Date' datatype='datetime' name='[Calculation_0153973914394646]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [customer_unique_id]: MIN([order_purchase_timestamp])}' />
            </column>
            <column caption='New vs Repeat Flag' datatype='string' name='[Calculation_0153973914972183]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_purchase_timestamp] = [Calculation_0153973914394646]&#13;&#10;THEN &quot;New&quot; &#13;&#10;ELSE &quot;Repeat&quot;&#13;&#10;END' />
            </column>
            <column caption='Customer Unique Id' datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' />
            <column-instance column='[payment_installments]' derivation='None' name='[none:payment_installments:ok]' pivot='key' type='ordinal' />
            <column-instance column='[product_category_name_english]' derivation='None' name='[none:product_category_name_english:nk]' pivot='key' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Payment Installments' datatype='integer' name='[payment_installments]' role='measure' type='quantitative' />
            <column caption='Payment Value' datatype='real' name='[payment_value]' role='measure' type='quantitative' />
            <column caption='Product Category Name English' datatype='string' name='[product_category_name_english]' role='dimension' type='nominal' />
            <column-instance column='[payment_value]' derivation='Sum' name='[sum:payment_value:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_purchase_timestamp]' derivation='Month-Trunc' name='[tmn:order_purchase_timestamp:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[Action (New vs Repeat Flag,MONTH(Order Purchase Timestamp))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action7_4CC236E99B51434090941042F544167B]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_0153973914972183]' />
              <groupfilter function='level-members' level='[tmn:order_purchase_timestamp:ok]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[Action (Payment Installments)]'>
            <groupfilter function='level-members' level='[none:payment_installments:ok]' user:ui-action-filter='[Action9_A429B874F8064E4DBA7FF48D5F9A5AC8]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[none:product_category_name_english:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([payment_value])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:product_category_name_english:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
