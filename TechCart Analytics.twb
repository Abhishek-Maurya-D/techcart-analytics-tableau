          <filter class='categorical' column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[Action (Customer Lifetime Value,RFM - Recency)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action18_925123A2024D450389A88C573F3A3A47]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_0153973413912582:ok]' />
