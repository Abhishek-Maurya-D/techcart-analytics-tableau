    <worksheet name='Churn by Region'>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset' name='federated.0ga9oxl0570y9314lgtkb0831lfu' />
          </datasources>
          <datasource-dependencies datasource='federated.0ga9oxl0570y9314lgtkb0831lfu'>
            <column caption='Customer Lifetime Value' datatype='real' name='[Calculation_0153973413912582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_unique_id] : SUM([payment_value])}' />
            </column>
            <column caption='RFM - Recency' datatype='integer' name='[Calculation_0153973417824263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, &#13;&#10;{FIXED [customer_unique_id] : MAX([order_purchase_timestamp])}, &#13;&#10;{FIXED : MAX([order_purchase_timestamp])}&#13;&#10;)' />
            </column>
            <column caption='Churn Indicator' datatype='string' name='[Calculation_1057773538766856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0153973417824263] &gt; 180 THEN &quot;Churned&quot; ELSE &quot;Active&quot; END' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Customer Unique Id' datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0153973413912582]' derivation='None' name='[none:Calculation_0153973413912582:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0153973417824263]' derivation='None' name='[none:Calculation_0153973417824263:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1057773538766856]' derivation='None' name='[none:Calculation_1057773538766856:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Payment Value' datatype='real' name='[payment_value]' role='measure' type='quantitative' />
            <column-instance column='[customer_unique_id]' derivation='CountD' name='[pcto:ctd:customer_unique_id:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ga9oxl0570y9314lgtkb0831lfu].[Action (Customer Lifetime Value,RFM - Recency)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action18_925123A2024D450389A88C573F3A3A47]' user:ui-enumeration='all' user:ui-marker='enumerate'>
