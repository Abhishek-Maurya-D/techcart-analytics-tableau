      <aliases enabled='yes' />
      <column caption='&quot;Order Id&quot;' datatype='string' name='[&quot;order_id&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Answer Timestamp&quot;' datatype='datetime' name='[&quot;review_answer_timestamp&quot;]' role='dimension' type='ordinal' />
      <column caption='&quot;Review Comment Message&quot;' datatype='string' name='[&quot;review_comment_message&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Comment Title&quot;' datatype='string' name='[&quot;review_comment_title&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Creation Date&quot;' datatype='string' name='[&quot;review_creation_date&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Id&quot;' datatype='string' name='[&quot;review_id&quot;]' role='dimension' type='nominal' />
      <column caption='Review Score' datatype='integer' name='[&quot;review_score&quot;]' role='measure' type='quantitative' />
      <column caption='Delivery Time' datatype='real' name='[Calculation_0153973206781952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_purchase_timestamp]-[order_delivered_customer_date]' />
      </column>
      <column caption='Delay Flag' datatype='string' name='[Calculation_0153973207515137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[order_delivered_customer_date]&gt;[order_estimated_delivery_date]&#13;&#10;THEN &quot;Late&quot; ELSE &quot;On Time&quot; END' />
      </column>
      <column caption='Revenue Per Order' datatype='real' name='[Calculation_0153973394739203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price])+SUM([freight_value])' />
      </column>
      <column caption='Customer Lifetime Value' datatype='real' name='[Calculation_0153973413912582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id] : SUM([payment_value])}' />
      </column>
      <column caption='RFM - Recency' datatype='integer' name='[Calculation_0153973417824263]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, &#13;&#10;{FIXED [customer_unique_id] : MAX([order_purchase_timestamp])}, &#13;&#10;{FIXED : MAX([order_purchase_timestamp])}&#13;&#10;)' />
      </column>
      <column caption='RFM - Frequency' datatype='integer' name='[Calculation_0153973418618888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id] : COUNTD([order_id])}' />
      </column>
      <column caption='RFM - Monetary ' datatype='real' name='[Calculation_0153973419081737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id]: SUM([payment_value])}' />
      </column>
      <column caption='Average Review Score by Category' datatype='real' name='[Calculation_0153973420072970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [product_category_name_english]:AVG([&quot;review_score&quot;])}' />
      </column>
      <column caption='MoM Growth' datatype='real' name='[Calculation_0153973420785675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([payment_value]) - LOOKUP(SUM([payment_value]), -1)) / ABS(LOOKUP(SUM([payment_value]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top-N Parameter-driven filter' datatype='boolean' name='[Calculation_0153973425352718]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([payment_value])) &lt;= [Parameters].[Parameter 0153973424582669]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Metric' datatype='real' name='[Calculation_0153973431996432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0153973431320591]&#13;&#10;WHEN &quot;Revenue&quot; THEN SUM([payment_value])&#13;&#10;WHEN &quot;Orders&quot; THEN COUNTD([order_id])&#13;&#10;WHEN &quot;Avg Review&quot; THEN AVG([&quot;review_score&quot;])&#13;&#10;END' />
      </column>
      <column caption='AOV (Average Order Value)' datatype='real' name='[Calculation_0153973857202193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value])/COUNTD([order_id])' />
      </column>
      <column caption='Growth Color Flag' datatype='string' name='[Calculation_0153973888098323]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0153973420785675]&gt;=0 THEN &quot;Positive&quot; ELSE &quot;Negative&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Delivery Time in Days' datatype='real' name='[Calculation_0153973894909972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_customer_date]))' />
      </column>
      <column caption='% On-Time Delivery' datatype='real' name='[Calculation_0153973896941589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_delivered_customer_date] &lt;= [order_estimated_delivery_date] THEN 1 ELSE 0 END)/COUNTD([Order_id])' />
      </column>
      <column caption='Customer&apos;s First Purchase Date' datatype='datetime' name='[Calculation_0153973914394646]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id]: MIN([order_purchase_timestamp])}' />
      </column>
      <column caption='New vs Repeat Flag' datatype='string' name='[Calculation_0153973914972183]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_purchase_timestamp] = [Calculation_0153973914394646]&#13;&#10;THEN &quot;New&quot; &#13;&#10;ELSE &quot;Repeat&quot;&#13;&#10;END' />
      </column>
      <column caption='Avg Seller Rating' datatype='real' name='[Calculation_0824952113106944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [seller_id] : AVG([&quot;review_score&quot;])}' />
      </column>
      <column caption='Seller Raging Flag' datatype='string' name='[Calculation_0824952114089985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0824952113106944] &gt;= 4 THEN &quot;Good&quot; &#13;&#10;ELSEIF [Calculation_0824952113106944] &gt;= 3 THEN &quot;Average&quot;&#13;&#10;ELSE &quot;Poor&quot; &#13;&#10;END' />
      </column>
      <column caption='Seller Rank Filter' datatype='boolean' name='[Calculation_0824952116199426]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(MIN([Calculation_0824952113106944]), &apos;asc&apos; ) &lt;= [Parameters].[Parameter 0153973424582669]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders per Seller' datatype='integer' name='[Calculation_0824952298405893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [seller_id] : COUNTD([order_id])}' />
      </column>
      <column caption='Late Delivery Rate by Seller' datatype='real' name='[Calculation_0824952301187078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [seller_id] : SUM(IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN 1 ELSE 0 END) } / { FIXED [seller_id] : COUNTD([Order_id]) }' />
      </column>
      <column caption='Limit to Top 20' datatype='boolean' name='[Calculation_1057772493201408]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(MIN([Calculation_0153973413912582])) &lt;= 20'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Recency Score' datatype='integer' name='[Calculation_1057772969811969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0153973417824263] &lt;= 30 THEN 5&#13;&#10;ELSEIF [Calculation_0153973417824263] &lt;= 90 THEN 4&#13;&#10;ELSEIF [Calculation_0153973417824263] &lt;= 180 THEN 3&#13;&#10;ELSEIF [Calculation_0153973417824263] &lt;= 365 THEN 2&#13;&#10;ELSE 1 &#13;&#10;END' />
      </column>
      <column caption='Frequency Score' datatype='integer' name='[Calculation_1057772970356738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0153973418618888] &gt;= 5 THEN 5&#13;&#10;ELSEIF [Calculation_0153973418618888] &gt;= 3 THEN 4&#13;&#10;ELSEIF [Calculation_0153973418618888] &gt;= 2 THEN 3&#13;&#10;ELSEIF [Calculation_0153973418618888] &gt;= 1 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Monetary Score' datatype='integer' name='[Calculation_1057772971110403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0153973413912582] &gt;= 500 THEN 5&#13;&#10;ELSEIF [Calculation_0153973413912582] &gt;= 250 THEN 4&#13;&#10;ELSEIF [Calculation_0153973413912582] &gt;= 100 THEN 3&#13;&#10;ELSEIF [Calculation_0153973413912582] &gt;= 50 THEN 2&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='RFM Segment' datatype='string' name='[Calculation_1057772977463301]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([Calculation_1057772969811969]) &gt;= 4 AND MIN([Calculation_1057772970356738]) &gt;= 4 AND MIN([Calculation_1057772971110403]) &gt;= 4&#13;&#10;THEN &quot;Champions&quot;&#13;&#10;ELSEIF MIN([Calculation_1057772969811969]) &gt;= 3 AND MIN([Calculation_1057772971110403]) &gt;= 3&#13;&#10;THEN &quot;Loyal Customers&quot;&#13;&#10;ELSEIF MIN([Calculation_1057772969811969]) &lt;= 2 AND MIN([Calculation_1057772971110403]) &gt;= 4&#13;&#10;THEN &quot;At Risk&quot;&#13;&#10;ELSEIF MIN([Calculation_1057772969811969]) &lt;= 2 AND MIN([Calculation_1057772970356738]) &lt;= 2&#13;&#10;THEN &quot;Lost&quot;&#13;&#10;ELSE &quot;Others / Needs Attention&quot;&#13;&#10;END' />
