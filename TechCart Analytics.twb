    <dashboard enable-sort-zone-taborder='true' name='Title &amp; Problem Statement'>
      <style />
      <size maxheight='860' maxwidth='1320' minheight='560' minwidth='1320' sizing-mode='range' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='97472' id='3' type-v2='text' w='98788' x='606' y='1264'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Project Title &amp; Problem Statement

</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Title: </run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>TechCart Analytics - Customer, Sales &amp; Revenue Intelligence Dashboard for a Tech-Enabled E-Commerce Marketplace. 
</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Problem Statement: </run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>TechCart is a fictional tech-enabled online marketplace connecting thousands of sellers with customers across a country, processing 1,00,000+ orders. Leadership has no unified view of sales performance, delivery efficiency, customer satisfaction, or seller performance. Data lives in scattered raw tables (orders, payments, products, customers, reviews, sellers, geolocation). You are hired as a Data Analyst to build a single source of truth: an interactive Tableau BI suite that answers &quot;how is the business really doing?&quot; and enables data-driven decisions on marketing spend, logistics, and seller management.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='30' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='97472' id='29' param='vert' type-v2='layout-flow' w='98788' x='606' y='1264'>
                <zone forceUpdate='true' h='97472' id='3' type-v2='text' w='98788' x='606' y='1264'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Project Title &amp; Problem Statement

</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Title: </run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>TechCart Analytics - Customer, Sales &amp; Revenue Intelligence Dashboard for a Tech-Enabled E-Commerce Marketplace. 
</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>Problem Statement: </run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='12'>TechCart is a fictional tech-enabled online marketplace connecting thousands of sellers with customers across a country, processing 1,00,000+ orders. Leadership has no unified view of sales performance, delivery efficiency, customer satisfaction, or seller performance. Data lives in scattered raw tables (orders, payments, products, customers, reviews, sellers, geolocation). You are hired as a Data Analyst to build a single source of truth: an interactive Tableau BI suite that answers &quot;how is the business really doing?&quot; and enables data-driven decisions on marketing spend, logistics, and seller management.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
